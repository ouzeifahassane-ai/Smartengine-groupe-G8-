{
  "name": "Churn Alert Workflow",
  "nodes": [
    {
      "parameters": {},
      "name": "Start",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "fileSelector": "C:/Users/ETYA'ALE/Documents/Smartengine-groupe-G8-/outputs/dataset_final.csv",
        "options": {}
      },
      "name": "Read Final Dataset",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "name": "Spreadsheet File",
      "type": "n8n-nodes-base.spreadsheetFile",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ \[\"Spreadsheet File\"].json[\"churn_probability\"] }}",
              "operation": "larger",
              "value2": 0.7
            }
          ]
        }
      },
      "name": "Filter High Risk",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "alerts@smartengine.com",
        "toEmail": "csm@smartengine.com",
        "subject": "🚨 Alerte Churn Critique : Compte {{ \[\"Filter High Risk\"].json[\"account_id\"] }}",
        "text": "Une probabilité élevée de churn a été détectée.\\n\\nCompte : {{ \[\"Filter High Risk\"].json[\"account_id\"] }}\\nSecteur : {{ \[\"Filter High Risk\"].json[\"industry\"] }}\\nScore de churn : {{ \[\"Filter High Risk\"].json[\"churn_probability\"] }}\\n\\nAction requise immédiate par l\\'équipe CSM.",
        "options": {}
      },
      "name": "Send Email Alert",
      "type": "n8n-nodes-base.email",
      "typeVersion": 1,
      "position": [
        1050,
        280
      ]
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Read Final Dataset",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Final Dataset": {
      "main": [
        [
          {
            "node": "Spreadsheet File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Spreadsheet File": {
      "main": [
        [
          {
            "node": "Filter High Risk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter High Risk": {
      "main": [
        [
          {
            "node": "Send Email Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "id": 1
}
